<?xml version="1.0" encoding="utf-8"?>
<!--
  Background drawable untuk unified bottom panel system.
  Menghasilkan tampilan rounded top corners layaknya Material Bottom Sheet.
  Digunakan oleh: textEditorBar, objectMenuPanel, canvasMenuPanel, effectsMenuPanel,
                  dan layout_effect_settings_panel.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners
        android:topLeftRadius="@dimen/panel_corner_radius"
        android:topRightRadius="@dimen/panel_corner_radius"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />

    <solid android:color="@color/panel_bg" />

</shape>
