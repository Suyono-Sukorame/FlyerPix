<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header dengan Tombol Cepat (Clear) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/edit_text_title"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textStyle="bold" />

        <!-- Tombol Hapus Cepat -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearText"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="44dp"
            android:paddingHorizontal="8dp"
            android:text="Clear"
            android:textColor="?attr/colorError" />

    </LinearLayout>

    <!-- Toolbar Formatting Kustom (Bold / Italic / Underline / Strikethrough) -->
    <HorizontalScrollView
        android:id="@+id/formatToolbarScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/formatToolbarContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBold"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="B"
                android:textColor="@color/brand_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItalic"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="I"
                android:textColor="@color/brand_navy"
                android:textSize="18sp"
                android:textStyle="italic" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnderline"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="U"
                android:textColor="@color/brand_navy"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStrikethrough"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="S"
                android:textColor="@color/brand_navy"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTextColor"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Color"
                android:textColor="@color/brand_navy"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTextSize"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Size"
                android:textColor="@color/brand_navy"
                android:textSize="11sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="8dp"
                android:background="#DDDDDD" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUppercase"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="UPPERCASE"
                android:textColor="@color/brand_navy"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCapitalize"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Capitalize"
                android:textColor="@color/brand_navy"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLowercase"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="lowercase"
                android:textColor="@color/brand_navy"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Input Teks Multi-line -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusTopStart="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/edit_text_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="4"
            android:maxLines="8"
            android:scrollbars="vertical"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textColorHint="@color/brand_blue" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
