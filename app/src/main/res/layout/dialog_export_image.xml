<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#242424"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Dialog -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Icon Ekspor"
            android:src="@drawable/ic_outline_share_24px"
            app:tint="#18C8F5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Ekspor Gambar (Save as Image)"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Simpan hasil desain tanpa handle seleksi dengan resolusi tajam hingga 4K Ultra HD."
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="#3A3A3A" />

    <!-- Format Berkas (PNG vs JPEG) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Format Gambar"
        android:textColor="#B0BEC5"
        android:textSize="12sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgFormat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbPng"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="PNG (Transparan)"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbJpg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="JPEG / JPG"
            android:textColor="@android:color/white"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- Preset Kualitas / Dimensi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Kualitas &amp; Dimensi (Ultra HD / 4K)"
        android:textColor="#B0BEC5"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerQuality"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/cat_tabs_box_indicator"
        android:paddingHorizontal="12dp" />

    <!-- Container Input Kustom (opsional) -->
    <LinearLayout
        android:id="@+id/layoutCustomSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:hint="Lebar (px)"
            app:boxStrokeColor="#18C8F5"
            app:hintTextColor="#18C8F5">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:hint="Tinggi (px)"
            app:boxStrokeColor="#18C8F5"
            app:hintTextColor="#18C8F5">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Info Resolusi Target Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#2E3A3F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Info Resolusi"
            android:src="@drawable/ic_aspect_ratio_24px"
            app:tint="#18C8F5" />

        <TextView
            android:id="@+id/tvResolutionPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="#18C8F5"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Resolusi: 3840 × 2160 piksel (4K Ultra HD)" />
    </LinearLayout>

</LinearLayout>
