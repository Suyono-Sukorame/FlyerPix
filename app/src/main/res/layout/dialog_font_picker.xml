<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_font_picker_sheet"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Font"
            android:textColor="@color/light_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFontCancel"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="Close font picker"
            android:text=""
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_sharp_clear_24px"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/light_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFontOk"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="Apply font"
            android:text=""
            app:backgroundTint="#EAF3FF"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_check_24px"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/brand_blue" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="106dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_font_preview_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="18dp">

        <TextView
            android:id="@+id/tvFontPreview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center|bottom"
            android:maxLines="2"
            android:text="New Text"
            android:textColor="#101828"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvSelectedFontName"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Current font"
            android:textColor="@color/light_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_font_tabs"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabFonts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_font_tab_item"
            android:gravity="center"
            android:text="FONTS"
            android:textColor="#1769FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabMyFonts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_font_tab_item"
            android:gravity="center"
            android:text="MY FONTS"
            android:textColor="#616161"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabRecent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_font_tab_item"
            android:gravity="center"
            android:text="RECENT"
            android:textColor="#616161"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/fontTabIndicator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#1769FF" />

    <TextView
        android:id="@+id/tvFontCategory"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:text="BASIC"
        android:textColor="#8A94A6"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchFont"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_font_search"
        android:queryHint="Search fonts..."
        android:iconifiedByDefault="false"
        android:paddingHorizontal="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFontPicker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingBottom="8dp"
        android:scrollbars="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_font_bottom_bar"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCustomFontFolder"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="+ FOLDER"
            android:textColor="#1769FF"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCustomFont"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="+ MY FONTS"
            android:textColor="#1769FF"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="20dp" />
    </LinearLayout>
</LinearLayout>
