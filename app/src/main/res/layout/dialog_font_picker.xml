<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#0B1838"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Font"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFontCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CANCEL"
            android:textColor="#B8C4DA"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFontOk"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APPLY"
            android:textColor="#29D3F2"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFontPreview"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="New Text"
        android:textColor="#1A1A2E"
        android:textSize="28sp"
        android:background="#F5F8FC"
        android:paddingHorizontal="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingHorizontal="8dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tabFonts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="FONTS"
            android:textColor="#1769FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabMyFonts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="MY FONTS"
            android:textColor="#616161"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabRecent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="RECENT"
            android:textColor="#616161"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/fontTabIndicator"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#1769FF" />

    <TextView
        android:id="@+id/tvFontCategory"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="Basic"
        android:textColor="#8A94A6"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchFont"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="4dp"
        android:background="#F5F8FC"
        android:queryHint="Search fonts"
        android:iconifiedByDefault="false"
        android:paddingHorizontal="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFontPicker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:scrollbars="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:background="#F5F8FC"
        android:paddingHorizontal="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCustomFont"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ My Fonts"
            android:textColor="#1769FF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>