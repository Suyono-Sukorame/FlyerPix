<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/light_surface_alt">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Adjust Image"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/light_text_primary" />
    </LinearLayout>

    <com.flyerpix.editor.imageedit.ImagePreEditView
        android:id="@+id/preEditView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/light_surface_alt" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_divider" />

    <!-- Baris 1: preset rasio (pill teks) + tombol Free -->
    <HorizontalScrollView
        android:id="@+id/ratioScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/light_surface_alt"
        android:scrollbars="none"
        android:fadeScrollbars="false">

        <LinearLayout
            android:id="@+id/ratioContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_divider" />

    <!-- Baris 2: rotate kanan | rotate kiri | zoom-out | zoom-in | lock | circle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@color/light_surface_alt">

        <ImageButton
            android:id="@+id/btnRotateRight"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="3dp"
            android:contentDescription="Rotate Kanan"
            android:src="@drawable/ic_rotate_right_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnRotateLeft"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="3dp"
            android:contentDescription="Rotate Kiri"
            android:src="@drawable/ic_rotate_left_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="3dp"
            android:contentDescription="Zoom Keluar"
            android:src="@drawable/ic_zoom_out_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="3dp"
            android:contentDescription="Zoom Masuk"
            android:src="@drawable/ic_zoom_in_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnLock"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="3dp"
            android:contentDescription="Lock Rasio"
            android:src="@drawable/ic_lock_open_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnShape"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="3dp"
            android:contentDescription="Crop Shape"
            android:src="@drawable/ic_sharp_circle_outline_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_divider" />

    <!-- Baris 3: cermin kanan | cermin kiri | close (x) | check (v) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"
        android:background="@color/light_surface_alt">

        <ImageButton
            android:id="@+id/btnFlipRight"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="3dp"
            android:contentDescription="Cermin Kanan"
            android:src="@drawable/ic_flip_horizontal_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnFlipLeft"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="3dp"
            android:contentDescription="Cermin Kiri"
            android:src="@drawable/ic_flip_vertical_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:contentDescription="Batal"
            android:src="@drawable/ic_sharp_clear_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnOk"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:contentDescription="Terapkan"
            android:src="@drawable/ic_check_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#1769FF"
            android:scaleType="center" />
    </LinearLayout>
</LinearLayout>