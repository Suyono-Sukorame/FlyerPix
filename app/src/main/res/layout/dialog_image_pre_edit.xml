<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/light_surface_alt">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Cancel"
            android:textSize="16sp"
            android:textColor="@color/light_text_primary"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Adjust Image"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/light_text_primary" />

        <TextView
            android:id="@+id/btnOk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="OK"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1769FF"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <com.flyerpix.editor.imageedit.ImagePreEditView
        android:id="@+id/preEditView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/light_surface_alt" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@color/light_surface_alt">

        <ImageButton
            android:id="@+id/btnRotateLeft"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="2dp"
            android:contentDescription="Rotate Left"
            android:src="@drawable/ic_rotate_left_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnRotateRight"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="2dp"
            android:contentDescription="Rotate Right"
            android:src="@drawable/ic_rotate_right_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="2dp"
            android:contentDescription="Zoom Keluar"
            android:src="@drawable/ic_zoom_out_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="2dp"
            android:contentDescription="Zoom Masuk"
            android:src="@drawable/ic_zoom_in_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnFlipHorizontal"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="2dp"
            android:contentDescription="Cermin Kiri-Kanan"
            android:src="@drawable/ic_flip_horizontal_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnFlipVertical"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="2dp"
            android:contentDescription="Flip Top-Bottom"
            android:src="@drawable/ic_flip_vertical_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnLock"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="2dp"
            android:contentDescription="Lock Ratio"
            android:src="@drawable/ic_lock_open_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />

        <ImageButton
            android:id="@+id/btnShape"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="2dp"
            android:contentDescription="Crop Shape"
            android:src="@drawable/ic_sharp_crop_free_24px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/light_text_primary"
            android:scaleType="center" />
    </LinearLayout>
</LinearLayout>