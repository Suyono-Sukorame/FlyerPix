<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- Konten utama gradient -->
    <LinearLayout
        android:id="@+id/gradientContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Gradient preview bar -->
        <View
            android:id="@+id/viewGradientPreview"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <!-- Two color pickers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start"
                    android:textSize="11sp"
                    android:textColor="#888888" />

                <View
                    android:id="@+id/viewColorStart"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="#FFFF512F" />

            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="8dp"
                android:src="@android:drawable/ic_menu_manage"
                android:contentDescription="arrow" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="End"
                    android:textSize="11sp"
                    android:textColor="#888888" />

                <View
                    android:id="@+id/viewColorEnd"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="#FFDD2476" />

            </LinearLayout>

        </LinearLayout>

        <!-- Gradient type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type"
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgGradientType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbLinear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Linear"
                android:checked="true"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbRadial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Radial"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbSweep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sweep"
                android:textSize="12sp" />

        </RadioGroup>

        <!-- Angle slider (Linear only) -->
        <LinearLayout
            android:id="@+id/layoutAngle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvAngleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Angle: 0°"
                android:textSize="11sp"
                android:textColor="#888888" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderAngle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0"
                android:valueTo="360"
                android:stepSize="1"
                android:value="0"
                app:labelBehavior="gone" />

        </LinearLayout>

        <!-- Gradient presets -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presets"
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGradientPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>

    <!-- Editor inline untuk satu stop (menggantikan dialog bertumpuk) -->
    <LinearLayout
        android:id="@+id/stopEditorSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopEditorBack"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:text="‹ Gradient"
                android:textSize="13sp"
                android:textColor="@color/brand_blue" />

            <TextView
                android:id="@+id/tvStopEditorTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Start Color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E" />

        </LinearLayout>

        <com.flyerpix.editor.ui.dialog.SolidColorEditorView
            android:id="@+id/inlineStopEditor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopEditorCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopEditorSet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set" />

        </LinearLayout>

    </LinearLayout>

    </LinearLayout>

</ScrollView>