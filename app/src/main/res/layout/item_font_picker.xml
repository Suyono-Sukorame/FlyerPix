<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFont"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="0dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="4dp"
    app:cardElevation="0dp"
    app:strokeColor="#E3E8F0"
    app:strokeWidth="0dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <!-- Preview visual langsung font -->
        <TextView
            android:id="@+id/tvFontPreview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Aaaarqh"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <!-- Nama Font -->
        <TextView
            android:id="@+id/tvFontName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Font Name"
            android:textColor="#26344D"
            android:textSize="11sp"
            android:textStyle="normal" />

        <!-- Kategori Font -->
        <TextView
            android:id="@+id/tvFontCategory"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="0"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Category"
            android:textColor="#888888"
            android:visibility="gone"
            android:textSize="8sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
