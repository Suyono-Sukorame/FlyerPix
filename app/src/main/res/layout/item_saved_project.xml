<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardProjectItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/brand_surface_darker"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeColor="#3E3E3E"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivProjectIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#37474F"
            android:padding="8dp"
            android:src="@drawable/ic_nav_presets_24px"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#18C8F5"
            android:contentDescription="Project Icon" />

        <TextView
            android:id="@+id/tvProjectName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnDeleteProject"
            app:layout_constraintStart_toEndOf="@+id/ivProjectIcon"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Desain Poster Acara" />

        <TextView
            android:id="@+id/tvProjectDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/btnDeleteProject"
            app:layout_constraintStart_toEndOf="@+id/ivProjectIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvProjectName"
            tools:text="1080×1080 • 5 Layer • 12 KB • 5 Sep 2026" />

        <ImageButton
            android:id="@+id/btnDeleteProject"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Hapus Proyek"
            android:src="@drawable/ic_delete_24px"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FF5252" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
