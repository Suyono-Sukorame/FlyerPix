<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="84dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPresetPreview"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="3dp"
        app:strokeColor="#555555"
        app:strokeWidth="1dp">

        <FrameLayout
            android:id="@+id/presetPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvPresetPreviewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="New\nText"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgPresetIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_outline_photo_24px"
                android:visibility="gone"
                app:tint="@android:color/white" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvPresetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Default"
        android:textColor="#E0E0E0"
        android:textSize="11sp" />

</LinearLayout>
