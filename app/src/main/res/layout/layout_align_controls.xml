<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel kontrol Perataan Teks untuk TextLayer.
  Gaya kompak ala 3D Text: tombol perataan sebaris + grup Wrap Text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alignControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlignLeft"
            style="@style/LightPanelOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            app:icon="@drawable/ic_align_left_24"
            app:iconSize="18dp"
            android:contentDescription="Kiri" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlignCenter"
            style="@style/LightPanelOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            app:icon="@drawable/ic_align_center_24"
            app:iconSize="18dp"
            android:contentDescription="Center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlignRight"
            style="@style/LightPanelOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            app:icon="@drawable/ic_align_right_24"
            app:iconSize="18dp"
            android:contentDescription="Kanan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlignJustify"
            style="@style/LightPanelOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            app:icon="@drawable/ic_align_justify_24"
            app:iconSize="18dp"
            android:contentDescription="Rata" />
    </LinearLayout>

    <!-- ── Wrap Text ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Text Wrapping"
            android:textAppearance="?attr/textAppearanceCaption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWrapText"
            style="@style/LightPanelOutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Wrap"
            android:textSize="12sp"
            android:contentDescription="Enable text wrapping" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wrapControlsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvWrapWidth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Width: 600 px"
            android:textAppearance="?attr/textAppearanceCaption" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderWrapWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="60"
            android:valueTo="1600"
            android:stepSize="10"
            android:value="600"
            app:labelBehavior="gone" />
    </LinearLayout>
</LinearLayout>