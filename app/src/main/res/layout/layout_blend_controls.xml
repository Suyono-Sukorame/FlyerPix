<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel kontrol Blending Mode untuk CanvasLayer (TextLayer, dll).
  Gaya kompak ala 3D Text: header caption + tombol reset sebaris,
  strip mode horizontal (7 populer + 6 lanjutan, yang lanjutan
  disembunyikan pada perangkat API < 28 karena PorterDuff.Mode diperluas).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/blendControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:visibility="gone">

    <!-- ── Header: Label & Tombol Reset sebaris ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Blending Mode"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="#1A1A2E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetBlendMode"
            style="@style/LightPanelTextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Normal"
            android:textSize="12sp"
            android:textColor="@color/brand_blue"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- ── Status Mode Aktif & Penjelasan ── -->
    <TextView
        android:id="@+id/tvBlendDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="4dp"
        android:text="Normal: Menampilkan warna teks biasa di atas background."
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="#5F6368" />

    <!-- ── Tombol Pilihan Blending Mode ── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlendNormal"
                style="@style/LightPanelOutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:text="Normal"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:minWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlendMultiply"
                style="@style/LightPanelOutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:text="Multiply"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:minWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlendScreen"
                style="@style/LightPanelOutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:text="Screen"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:minWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlendOverlay"
                style="@style/LightPanelOutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:text="Overlay"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:minWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlendDarken"
                style="@style/LightPanelOutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:text="Darken"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:minWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlendLighten"
                style="@style/LightPanelOutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:text="Lighten"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:minWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBlendAdd"
                style="@style/LightPanelOutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:text="Add (Dodge)"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:minWidth="0dp" />

            <!-- Mode lanjutan: hanya aktif di perangkat API >= 28 -->
            <LinearLayout
                android:id="@+id/blendAdvancedRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBlendHardLight"
                    style="@style/LightPanelOutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:text="Hard Light"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBlendSoftLight"
                    style="@style/LightPanelOutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:text="Soft Light"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBlendColorBurn"
                    style="@style/LightPanelOutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:text="Burn"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBlendColorDodge"
                    style="@style/LightPanelOutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:text="Dodge"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBlendDifference"
                    style="@style/LightPanelOutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:text="Difference"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBlendExclusion"
                    style="@style/LightPanelOutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Exclusion"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>