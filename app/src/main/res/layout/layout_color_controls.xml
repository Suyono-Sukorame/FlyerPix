<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel kontrol Warna Teks.
  Gaya kompak ala 3D Text: baris warna (chip + hex + '+'),
  seret swatch palet, tombol Color Picker & Gradasi.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/colorControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Warna Teks"
        android:textAppearance="?attr/textAppearanceSubtitle2"
        android:textStyle="bold" />

    <!-- Warna aktif: preview + hex + tombol '+' -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Warna"
            android:textAppearance="?attr/textAppearanceCaption" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chipColorPreview"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#CCCCCC"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvColorValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="#FFFFFFFF"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="#1A1A2E" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickColor"
            style="@style/LightPanelOutlinedButton"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:padding="0dp"
                app:icon="@drawable/ic_add_24px"
                app:iconSize="18dp" />
    </LinearLayout>

    <!-- Palet Swatch -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutColorSwatches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- Tombol Color Picker & Gradasi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnColorPicker"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Pilih Warna"
            android:textSize="11sp"
            app:icon="@drawable/ic_sharp_palette_24px"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnColorGradient"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Gradasi"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>