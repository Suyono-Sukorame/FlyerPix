<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel kontrol Curved / Arc Text untuk TextLayer.
  Gaya kompak ala 3D Text: judul + tombol reset sebaris,
  label nilai dinamis, slider -100..+100, dan grid preset 5 tombol.
  Nilai 0% (Flat) berarti teks lurus / lengkungan mati.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/curveControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:visibility="gone">

    <!-- ── Judul & Tombol Reset ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Curved Text"
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetCurve"
            style="@style/LightPanelTextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Reset"
            android:textSize="12sp"
            android:textColor="@color/brand_blue"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- ── Label nilai curve ── -->
    <TextView
        android:id="@+id/tvCurveLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="4dp"
        android:text="Curve: 0% (Flat)"
        android:textAppearance="?attr/textAppearanceCaption" />

    <!-- ── Slider Curve -100 s/d +100 ── -->
    <com.google.android.material.slider.Slider
        android:id="@+id/sliderCurve"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="-100"
        android:valueTo="100"
        android:stepSize="1"
        android:value="0"
        app:labelBehavior="gone" />

    <!-- ── Grid Preset ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCurveDown100"
            style="@style/LightPanelOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="▼ 100%"
            android:textSize="10sp"
            android:paddingHorizontal="4dp"
            android:minWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCurveDown50"
            style="@style/LightPanelOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="▼ 50%"
            android:textSize="10sp"
            android:paddingHorizontal="4dp"
            android:minWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCurveFlat"
            style="@style/LightPanelOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="─ 0%"
            android:textSize="10sp"
            android:paddingHorizontal="4dp"
            android:minWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCurveUp50"
            style="@style/LightPanelOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="▲ 50%"
            android:textSize="10sp"
            android:paddingHorizontal="4dp"
            android:minWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCurveUp100"
            style="@style/LightPanelOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="▲ 100%"
            android:textSize="10sp"
            android:paddingHorizontal="4dp"
            android:minWidth="0dp" />
    </LinearLayout>

</LinearLayout>