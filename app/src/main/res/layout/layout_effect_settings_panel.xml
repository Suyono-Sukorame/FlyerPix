<?xml version="1.0" encoding="utf-8"?>
<!--
  Effect Settings Page (UX ala PixelLab): halaman khusus yang mengambil alih
  area tool strip + panel properti saat pengguna mengedit efek kompleks.
  Header: judul efek + ikon ✓ (terapkan) dan ✕ (batal/kembali).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/effectSettingsPanel"
    android:layout_width="match_parent"
    android:layout_height="145dp"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:elevation="6dp"
    android:theme="@style/LightPanelTheme"
    android:visibility="gone">

    <!-- Kontrol efek berada di kiri; aksinya tetap terlihat di kanan. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#F2F4F8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/effectSettingsTitle"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:text="Effect Settings"
                android:textColor="#1A1A2E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/effectSettingsScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none"
                android:fadeScrollbars="false">

<LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <!-- Position -->
                    <include
                        layout="@layout/layout_position_controls"
                        android:id="@+id/positionControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Relative Position -->
                    <include
                        layout="@layout/layout_relative_position_controls"
                        android:id="@+id/relativePositionControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Size -->
                    <include
                        layout="@layout/layout_size_controls"
                        android:id="@+id/sizeControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Styles (Tersimpan) -->
                    <include
                        layout="@layout/layout_styles_controls"
                        android:id="@+id/stylesControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Drop Shadow -->
                    <include
                        layout="@layout/layout_shadow_controls"
                        android:id="@+id/shadowControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Stroke / Outline -->
                    <include
                        layout="@layout/layout_stroke_controls"
                        android:id="@+id/strokeControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Spacing (Letter / Line) -->
                    <include
                        layout="@layout/layout_spacing_controls"
                        android:id="@+id/spacingControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Align (Perataan) -->
                    <include
                        layout="@layout/layout_align_controls"
                        android:id="@+id/alignControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Background -->
                    <include
                        layout="@layout/layout_background_controls"
                        android:id="@+id/backgroundControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Curve / Arc Text -->
                    <include
                        layout="@layout/layout_curve_controls"
                        android:id="@+id/curveControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Style (Gaya Teks) -->
                    <include
                        layout="@layout/layout_style_controls"
                        android:id="@+id/styleControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Mask (Masking Foto) -->
                    <include
                        layout="@layout/layout_mask_controls"
                        android:id="@+id/maskControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Opacity -->
                    <include
                        layout="@layout/layout_opacity_controls"
                        android:id="@+id/opacityControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Rotate -->
                    <include
                        layout="@layout/layout_rotate_controls"
                        android:id="@+id/rotateControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Color (Warna Teks) -->
                    <include
                        layout="@layout/layout_color_controls"
                        android:id="@+id/colorControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Padding -->
                    <include
                        layout="@layout/layout_padding_controls"
                        android:id="@+id/paddingControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Inner Shadow -->
                    <include
                        layout="@layout/layout_inner_shadow_controls"
                        android:id="@+id/innerShadowControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Emboss / Bevel -->
                    <include
                        layout="@layout/layout_emboss_controls"
                        android:id="@+id/embossControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Gradient Fill -->
                    <include
                        layout="@layout/layout_gradient_controls"
                        android:id="@+id/gradientControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Texture Masking -->
                    <include
                        layout="@layout/layout_texture_controls"
                        android:id="@+id/textureControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- 3D Text Extrusion -->
                    <include
                        layout="@layout/layout_extrude_controls"
                        android:id="@+id/extrudeControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- 3D Shadow -->
                    <include
                        layout="@layout/layout_3d_shadow_controls"
                        android:id="@+id/shadow3DControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Reflection -->
                    <include
                        layout="@layout/layout_reflection_controls"
                        android:id="@+id/reflectionControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- 3D Rotate -->
                    <include
                        layout="@layout/layout_3d_rotate_controls"
                        android:id="@+id/rotate3DControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Perspective Warping -->
                    <include
                        layout="@layout/layout_perspective_controls"
                        android:id="@+id/perspectiveControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Blending Mode -->
                    <include
                        layout="@layout/layout_blend_controls"
                        android:id="@+id/blendControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Neon / Glow -->
                    <include
                        layout="@layout/layout_neon_controls"
                        android:id="@+id/neonControlsInclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/btnEffectApply"
            style="?attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_check_24px"
            app:tint="#1769FF"
            android:contentDescription="Terapkan pengaturan" />

        <ImageButton
            android:id="@+id/btnEffectCancel"
            style="?attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_sharp_clear_24px"
            app:tint="#E53935"
            android:contentDescription="Batal / keluar" />
    </LinearLayout>
</LinearLayout>