<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel kontrol Emboss / Bevel untuk TextLayer.
  Mengikuti gaya UI/UX 3D Text: slider berpasangan 2 kolom + label nilai dinamis.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/embossControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:visibility="gone">

    <!-- ── Toggle enable/disable ── -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchEmbossEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Emboss / Bevel"
        android:textAppearance="?attr/textAppearanceBody2"
        android:checked="false" />

    <!-- ── Group slider ── -->
    <LinearLayout
        android:id="@+id/embossSliderGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="2dp"
        android:visibility="gone">

        <!-- Light Angle & Bevel Thickness sebaris (2 kolom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmbossAngleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Light Angle (45°)"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderEmbossAngle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="360"
                    android:stepSize="1"
                    android:value="45"
                    app:labelBehavior="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmbossBevelLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Bevel: 3"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderEmbossBevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.5"
                    android:valueTo="12"
                    android:stepSize="0.1"
                    android:value="3"
                    app:labelBehavior="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ambient Light & Specular sebaris (2 kolom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmbossAmbientLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Ambient: 0.2"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderEmbossAmbient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:stepSize="0.01"
                    android:value="0.2"
                    app:labelBehavior="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmbossSpecularLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Specular: 8"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderEmbossSpecular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.1"
                    android:valueTo="20"
                    android:stepSize="0.1"
                    android:value="8"
                    app:labelBehavior="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Emboss Intensity (full width, ganjil) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmbossIntensityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Intensity: 1"
                android:textAppearance="?attr/textAppearanceCaption" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderEmbossIntensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="2.5"
                android:stepSize="0.05"
                android:value="1"
                app:labelBehavior="gone" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>