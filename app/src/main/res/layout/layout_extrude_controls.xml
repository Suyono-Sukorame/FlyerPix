<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel kontrol 3D Text Extrusion untuk TextLayer.
  Membuat efek ketebalan/volume 3D dengan tumpukan layer depth (1 s/d 50).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/extrudeControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchExtrudeEnabled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3D Text"
            android:textAppearance="?attr/textAppearanceBody2"
            android:checked="false" />

        <RadioGroup
            android:id="@+id/rgExtrudeViewType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/rbOblique"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Oblique"
                android:checked="true"
                android:textSize="11sp" />

            <RadioButton
                android:id="@+id/rbIsometric"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Isometric"
                android:textSize="11sp" />
        </RadioGroup>
    </LinearLayout>

    <!-- ── Group Kontrol 3D Extrusion ── -->
    <LinearLayout
        android:id="@+id/extrudeControlsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="2dp"
        android:visibility="gone">

        <!-- Depth & Angle sebaris (2 kolom) untuk menghemat ruang vertikal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvExtrudeDepthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Depth: 10"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderExtrudeDepth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1"
                    android:valueTo="50"
                    android:stepSize="1"
                    android:value="10"
                    app:labelBehavior="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/extrudeAngleContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvExtrudeAngleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Angle (45°)"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderExtrudeAngle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="360"
                    android:stepSize="1"
                    android:value="45"
                    app:labelBehavior="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Depth Color: preview ringkas + label + tombol '+' membuka ColorPickerDialog -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Depth Color"
                android:textAppearance="?attr/textAppearanceCaption" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipDepthColorPreview"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#CCCCCC"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvDepthColorValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="#333333"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="#1A1A2E" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickDepthColor"
                style="@style/LightPanelOutlinedButton"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>