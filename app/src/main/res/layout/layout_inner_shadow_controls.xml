<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel kontrol Inner Shadow untuk TextLayer.
  Mengikuti gaya UI/UX 3D Text: slider berpasangan 2 kolom + baris color picker.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/innerShadowControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:visibility="gone">

    <!-- ── Toggle enable/disable ── -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchInnerShadowEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inner Shadow"
        android:textAppearance="?attr/textAppearanceBody2"
        android:checked="false" />

    <!-- ── Group Kontrol Inner Shadow ── -->
    <LinearLayout
        android:id="@+id/innerShadowSliderGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="2dp"
        android:visibility="gone">

        <!-- Blur Radius & Opacity sebaris (2 kolom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInnerShadowRadiusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Blur: 6"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderInnerShadowRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="40"
                    android:stepSize="0.5"
                    android:value="6"
                    app:labelBehavior="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInnerShadowOpacityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Opacity: 80%"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderInnerShadowOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:stepSize="0.01"
                    android:value="0.8"
                    app:labelBehavior="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Offset X & Offset Y sebaris (2 kolom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInnerShadowDxLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Offset X: 0"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderInnerShadowDx"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="-30"
                    android:valueTo="30"
                    android:stepSize="0.5"
                    android:value="0"
                    app:labelBehavior="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInnerShadowDyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Offset Y: 4"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderInnerShadowDy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="-30"
                    android:valueTo="30"
                    android:stepSize="0.5"
                    android:value="4"
                    app:labelBehavior="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shadow Color: preview ringkas + label + tombol '+' membuka ColorPickerDialog -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Color"
                android:textAppearance="?attr/textAppearanceCaption" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipInnerShadowColorPreview"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#CCCCCC"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvInnerShadowColorValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="#FF000000"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="#1A1A2E" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickInnerShadowColor"
                style="@style/LightPanelOutlinedButton"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_add_24px"
                app:iconSize="18dp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>