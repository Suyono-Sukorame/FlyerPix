<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#212121"
    android:paddingBottom="16dp">

    <!-- Top Drag Handle Bar -->
    <View
        android:id="@+id/bottomSheetDragHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:background="#666666"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header: Icon & Judul Pengelola Lapisan -->
    <ImageView
        android:id="@+id/ivHeaderIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:src="@drawable/ic_layers_24px"
        app:tint="#18C8F5"
        android:contentDescription="Layers Header Icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bottomSheetDragHandle" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="Pengelola Lapisan"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/ivHeaderIcon"
        app:layout_constraintTop_toTopOf="@id/ivHeaderIcon"
        app:layout_constraintBottom_toBottomOf="@id/ivHeaderIcon" />

    <!-- Badge Jumlah Layer -->
    <TextView
        android:id="@+id/tvLayerCountBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="#37474F"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="#18C8F5"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="3 Layer"
        app:layout_constraintStart_toEndOf="@id/tvHeaderTitle"
        app:layout_constraintTop_toTopOf="@id/tvHeaderTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvHeaderTitle" />

    <!-- Tombol Mode Merge (Prompt 36) -->
    <ImageButton
        android:id="@+id/btnToggleMergeMode"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_merge_type_24px"
        app:tint="#18C8F5"
        android:contentDescription="Mode Gabungkan Layer"
        app:layout_constraintEnd_toStartOf="@id/btnCloseBottomSheet"
        app:layout_constraintTop_toTopOf="@id/tvHeaderTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvHeaderTitle" />

    <!-- Tombol Tutup -->
    <ImageButton
        android:id="@+id/btnCloseBottomSheet"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_sharp_clear_24px"
        app:tint="#AAAAAA"
        android:contentDescription="Tutup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvHeaderTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvHeaderTitle" />

    <!-- Garis Pembatas Header -->
    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#333333"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle" />

    <!-- Empty State View: Ditampilkan jika belum ada layer di kanvas -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/dividerHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_layers_24px"
            app:tint="#555555"
            android:contentDescription="Empty state icon" />

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Belum ada layer di kanvas"
            android:textColor="#777777"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- RecyclerView Daftar Layer dari Atas ke Bawah (Urutan Z-Index Terbalik) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLayers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:maxHeight="340dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toBottomOf="@id/dividerHeader"
        app:layout_constraintBottom_toTopOf="@id/layoutMergeActionBar"
        tools:itemCount="3"
        tools:listitem="@layout/item_layer" />

    <!-- Panel Aksi Mode Merge (Prompt 36) - Muncul saat Mode Merge aktif -->
    <LinearLayout
        android:id="@+id/layoutMergeActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/brand_surface_darker"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/rvLayers"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvMergeCountStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pilih minimal 2 layer"
            android:textColor="#BBBBBB"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelMerge"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Batal"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExecuteMerge"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="Gabungkan"
            android:textSize="13sp"
            android:textColor="@android:color/black"
            app:backgroundTint="#18C8F5"
            app:icon="@drawable/ic_merge_type_24px"
            app:iconTint="@android:color/black"
            app:iconGravity="textStart"
            android:enabled="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
