<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/objectToolStripScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel_bg"
    android:elevation="0dp"
    android:visibility="gone">

    <!-- Divider atas pemisah dari content panel -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/panel_divider" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/panel_compact_bar_height"
        android:background="@color/panel_strip_bg"
        android:scrollbars="none"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/objectToolStripContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

</LinearLayout>