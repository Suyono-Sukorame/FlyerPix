<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel kontrol Transformasi Perspektif Warping untuk CanvasLayer / TextLayer.
  Gaya kompak ala 3D Text: switch + tombol reset sebaris, strip preset cepat
  horizontal dengan highlight preset aktif.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/perspectiveControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:visibility="gone">

    <!-- ── Header: Switch & Tombol Reset sebaris ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPerspectiveEnabled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Perspective (3D Warp)"
            android:textAppearance="?attr/textAppearanceBody2"
            android:checked="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetPerspective"
            style="@style/LightPanelTextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Reset"
            android:textSize="12sp"
            android:textColor="@color/brand_blue"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- ── Kontainer Kontrol (Hanya tampil saat switch aktif) ── -->
    <LinearLayout
        android:id="@+id/perspectiveControlsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Drag the 4 corner handles on the canvas to adjust the warp plane."
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="#5F6368" />

        <!-- ── Preset Perspektif Cepat ── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetFlat"
                    style="@style/LightPanelOutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:text="Flat"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetSlightLeft"
                    style="@style/LightPanelOutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:text="Smooth Left"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetLeftWall"
                    style="@style/LightPanelOutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:text="◖ Left Wall"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetRightWall"
                    style="@style/LightPanelOutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:text="◗ Right Wall"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetGentleTilt"
                    style="@style/LightPanelOutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:text="Smooth Italic"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetBillboard"
                    style="@style/LightPanelOutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:text="▲ Billboard"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetFloor"
                    style="@style/LightPanelOutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="▼ Floor"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>