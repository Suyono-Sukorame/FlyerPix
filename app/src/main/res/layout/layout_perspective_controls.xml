<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel kontrol Transformasi Perspektif Warping untuk CanvasLayer / TextLayer.
  Mendukung Matrix.setPolyToPoly (4 titik sudut) dengan preset dan reset.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/perspectiveControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <!-- ── Header: Judul, Switch & Tombol Reset ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Perspektif (3D Warp)"
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPerspectiveEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetPerspective"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Reset"
            android:textSize="12sp"
            android:textColor="?attr/colorSecondary"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- ── Kontainer Kontrol (Hanya tampil saat switch aktif) ── -->
    <LinearLayout
        android:id="@+id/perspectiveControlsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Geser 4 titik sudut handle pada kanvas untuk menyesuaikan bidang miring."
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="#AAAAAA" />

        <!-- ── Preset Perspektif Cepat ── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetFlat"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="Datar (Flat)"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetLeftWall"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="Tembok Kiri ◖"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetRightWall"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="◗ Tembok Kanan"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetBillboard"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="▲ Billboard Atas"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetFloor"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="▼ Lantai / Bawah"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp"
                    android:minWidth="0dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
