<?xml version="1.0" encoding="utf-8"?>
<!--
  Relative Position Controls - Compact Symbol-Only Layout
  Design: Input px + slider with +/- buttons, directional arrows, confirm/close buttons
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relativePositionControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:visibility="gone">

    <!-- Row 1: Input + Confirm/Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Input Field: Move by _px -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Move by:"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/etRelMovePixels"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:inputType="numberSigned"
            android:hint="px"
            android:text="10"
            android:textSize="12sp"
            android:padding="6dp"
            android:background="@drawable/bg_panel_input"
            android:gravity="center" />

        <!-- Confirm Button (✓) -->
        <ImageButton
            android:id="@+id/btnRelConfirm"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_check_24px"
            android:contentDescription="Confirm"
            android:scaleType="centerInside"
            app:tint="@color/brand_blue" />

        <!-- Close Button (✕) -->
        <ImageButton
            android:id="@+id/btnRelClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_sharp_clear_24px"
            android:contentDescription="Close"
            android:scaleType="centerInside"
            app:tint="@color/light_text_secondary" />
    </LinearLayout>

    <!-- Row 2: Slider with +/- buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Minus Button (-) -->
        <ImageButton
            android:id="@+id/btnRelMinus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_sharp_remove_circle_outline"
            android:contentDescription="Decrease"
            android:scaleType="fitCenter"
            app:tint="@color/light_text_secondary" />

        <!-- Slider -->
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderRelMove"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:valueFrom="0"
            android:valueTo="200"
            android:stepSize="1"
            android:value="10"
            app:labelBehavior="gone"
            app:haloRadius="8dp" />

        <!-- Plus Button (+) -->
        <ImageButton
            android:id="@+id/btnRelPlus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add_24px"
            android:contentDescription="Increase"
            android:scaleType="fitCenter"
            app:tint="@color/light_text_secondary" />
    </LinearLayout>

    <!-- Row 3: Directional Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <!-- Left Arrow -->
        <ImageButton
            android:id="@+id/btnRelLeft"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_rotate_left_24px"
            android:contentDescription="Move Left"
            android:scaleType="centerInside"
            app:tint="@color/header_primary" />

        <!-- Right Arrow -->
        <ImageButton
            android:id="@+id/btnRelRight"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_rotate_right_24px"
            android:contentDescription="Move Right"
            android:scaleType="centerInside"
            app:tint="@color/header_primary" />

        <!-- Center Dot -->
        <ImageButton
            android:id="@+id/btnRelCenter"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_circle_24px"
            android:contentDescription="Center"
            android:scaleType="centerInside"
            app:tint="@color/panel_icon_tint" />

        <!-- Up Arrow -->
        <ImageButton
            android:id="@+id/btnRelUp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_zoom_in_24px"
            android:contentDescription="Move Up"
            android:scaleType="centerInside"
            app:tint="@color/header_primary" />

        <!-- Down Arrow -->
        <ImageButton
            android:id="@+id/btnRelDown"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_zoom_out_24px"
            android:contentDescription="Move Down"
            android:scaleType="centerInside"
            app:tint="@color/header_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>