<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel kontrol Drop Shadow untuk TextLayer.
  Gaya kompak ala 3D Text: switch + tombol reset sebaris,
  baris warna (chip + hex + '+'), slider berpasangan 2 kolom dengan label dinamis.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shadowControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchShadowEnabled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bayangan"
            android:textAppearance="?attr/textAppearanceBody2"
            android:checked="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetShadow"
            style="@style/LightPanelTextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Reset"
            android:textSize="12sp"
            android:textColor="@color/brand_blue"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- ── Group Kontrol Shadow ── -->
    <LinearLayout
        android:id="@+id/shadowSliderGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="2dp"
        android:visibility="gone">

        <!-- Warna Shadow: preview + hex + tombol '+' -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Warna"
                android:textAppearance="?attr/textAppearanceCaption" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipShadowColorPreview"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#CCCCCC"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvShadowColorValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="#FF000000"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="#1A1A2E" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickShadowColor"
                style="@style/LightPanelOutlinedButton"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_add_24px"
                app:iconSize="18dp" />
        </LinearLayout>

        <!-- Blur & Opacity sebaris (2 kolom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvShadowRadiusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Blur: 8 px"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderShadowRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="40"
                    android:stepSize="0.5"
                    android:value="8"
                    app:labelBehavior="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvShadowOpacityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Opasitas: 60%"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderShadowOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:stepSize="0.01"
                    android:value="0.6"
                    app:labelBehavior="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Offset X & Y sebaris (2 kolom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvShadowDxLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Offset X: 4 px"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderShadowDx"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="-30"
                    android:valueTo="30"
                    android:stepSize="0.5"
                    android:value="4"
                    app:labelBehavior="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvShadowDyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Offset Y: 4 px"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderShadowDy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="-30"
                    android:valueTo="30"
                    android:stepSize="0.5"
                    android:value="4"
                    app:labelBehavior="gone" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>