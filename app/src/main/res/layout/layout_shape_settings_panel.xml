<?xml version="1.0" encoding="utf-8"?>
<!--
  Shape Settings Panel - Panel pengaturan Shape yang compact dengan full-width.
  Memakai komponen reusable DetailPanel (view_detail_panel.xml): handle + header
  (judul + ✓ Apply / ✕ Cancel) + area konten scrollable.
  Tinggi panel dikelola PanelHeightManager agar tidak menutupi canvas.
-->
<com.flyerpix.editor.ui.view.DetailPanel xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shapeSettingsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel_bottom"
    android:elevation="@dimen/panel_elevation"
    android:theme="@style/LightPanelTheme"
    android:visibility="gone">

    <!-- Corner Radius Slider -->
    <LinearLayout
        android:id="@+id/shapeCornerRadiusControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sliderLabelCorner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Corner Radius"
                android:textSize="12sp"
                android:textColor="@color/panel_text_secondary" />

            <TextView
                android:id="@+id/sliderValueCorner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/panel_text_primary" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sliderCorner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="100" />
    </LinearLayout>

    <!-- Opacity Slider -->
    <LinearLayout
        android:id="@+id/shapeOpacityControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sliderLabelOpacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Opacity"
                android:textSize="12sp"
                android:textColor="@color/panel_text_secondary" />

            <TextView
                android:id="@+id/sliderValueOpacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/panel_text_primary" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sliderOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="100" />
    </LinearLayout>

    <!-- Fill Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:paddingHorizontal="16dp"
        android:text="Fill"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/panel_text_primary" />

    <!-- Fill Color Picker Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Color"
            android:textSize="12sp"
            android:textColor="@color/panel_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShapeFillColor"
            style="@style/LightPanelOutlinedButton"
            android:layout_width="60dp"
            android:layout_height="36dp"
            android:text="Solid"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/shapeColorPreview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#CCCCCC"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/shapeColorPreviewInner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Fill Gradient Toggle -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchShapeFillGradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Gradient Fill"
        android:textSize="12sp"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Stroke Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:paddingHorizontal="16dp"
        android:text="Stroke"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/panel_text_primary" />

    <!-- Stroke Width Slider -->
    <LinearLayout
        android:id="@+id/shapeStrokeWidthControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sliderLabelStroke"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stroke Width"
                android:textSize="12sp"
                android:textColor="@color/panel_text_secondary" />

            <TextView
                android:id="@+id/sliderValueStroke"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/panel_text_primary" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sliderStroke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="50" />
    </LinearLayout>

    <!-- Stroke Opacity Slider -->
    <LinearLayout
        android:id="@+id/shapeStrokeOpacityControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sliderLabelStrokeOpacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stroke Opacity"
                android:textSize="12sp"
                android:textColor="@color/panel_text_secondary" />

            <TextView
                android:id="@+id/sliderValueStrokeOpacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/panel_text_primary" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sliderStrokeOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="100" />
    </LinearLayout>

    <!-- Stroke Color Picker Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stroke Color"
            android:textSize="12sp"
            android:textColor="@color/panel_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShapeStrokeColor"
            style="@style/LightPanelOutlinedButton"
            android:layout_width="60dp"
            android:layout_height="36dp"
            android:text="Solid"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/shapeStrokeColorPreview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#CCCCCC"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/shapeStrokeColorPreviewInner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Stroke Gradient Toggle -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchShapeStrokeGradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Gradient Stroke"
        android:textSize="12sp"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Join Style Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:paddingHorizontal="16dp"
        android:text="Corner/Join Style"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/panel_text_primary" />

    <RadioGroup
        android:id="@+id/rgShapeJoinStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="8dp">

        <RadioButton
            android:id="@+id/rbJoinMiter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Miter"
            android:textSize="11sp"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbJoinBevel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bevel"
            android:textSize="11sp" />

        <RadioButton
            android:id="@+id/rbJoinRound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Round"
            android:textSize="11sp" />
    </RadioGroup>

    <!-- Blur Radius Slider -->
    <LinearLayout
        android:id="@+id/shapeBlurRadiusControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sliderLabelBlur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Blur Radius"
                android:textSize="12sp"
                android:textColor="@color/panel_text_secondary" />

            <TextView
                android:id="@+id/sliderValueBlur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/panel_text_primary" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sliderBlur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="50" />
    </LinearLayout>

</com.flyerpix.editor.ui.view.DetailPanel>