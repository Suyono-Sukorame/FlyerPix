<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel kontrol Text Spacing (Spasi Huruf / Kerning & Spasi Baris / Leading) untuk TextLayer.
  Prompt 23: Pengaturan tipografi lanjut dengan slider reaktif ke canvas.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/spacingControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <!-- ── Header: Judul & Tombol Reset ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Spasi Teks (Kerning &amp; Leading)"
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetSpacing"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Reset"
            android:textSize="12sp"
            android:textColor="?attr/colorSecondary"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- ── Bagian 1: Spasi Huruf (Letter Spacing / Kerning) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvLetterSpacingLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Spasi Huruf: 0.00"
            android:textAppearance="?attr/textAppearanceCaption" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kerning"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="#888888" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderLetterSpacing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="-0.2"
        android:valueTo="1.0"
        android:stepSize="0.02"
        android:value="0.0"
        app:labelBehavior="gone" />

    <!-- Preset Spasi Huruf Cepat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLetterTight"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Rapat (-0.1)"
            android:textSize="10sp"
            android:paddingHorizontal="2dp"
            android:minWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLetterNormal"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Normal (0)"
            android:textSize="10sp"
            android:paddingHorizontal="2dp"
            android:minWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLetterMedium"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Sedang (+0.15)"
            android:textSize="10sp"
            android:paddingHorizontal="2dp"
            android:minWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLetterWide"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="Lebar (+0.4)"
            android:textSize="10sp"
            android:paddingHorizontal="2dp"
            android:minWidth="0dp" />
    </LinearLayout>

    <!-- ── Bagian 2: Spasi Baris (Line Spacing / Leading) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvLineSpacingLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Spasi Baris: 0 px"
            android:textAppearance="?attr/textAppearanceCaption" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leading"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="#888888" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderLineSpacing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="-20"
        android:valueTo="80"
        android:stepSize="2"
        android:value="0"
        app:labelBehavior="gone" />

    <!-- Preset Spasi Baris Cepat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLineTight"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Rapat (-10)"
            android:textSize="10sp"
            android:paddingHorizontal="2dp"
            android:minWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLineNormal"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Normal (0)"
            android:textSize="10sp"
            android:paddingHorizontal="2dp"
            android:minWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLineMedium"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Renggang (+20)"
            android:textSize="10sp"
            android:paddingHorizontal="2dp"
            android:minWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLineWide"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="Lebar (+40)"
            android:textSize="10sp"
            android:paddingHorizontal="2dp"
            android:minWidth="0dp" />
    </LinearLayout>
</LinearLayout>
