<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel kontrol Stroke / Outline untuk TextLayer.
  Gaya kompak ala 3D Text: switch + tombol reset sebaris,
  baris warna (chip + hex + '+'), slider berpasangan 2 kolom dengan label dinamis.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/strokeControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchStrokeEnabled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Outline / Stroke"
            android:textAppearance="?attr/textAppearanceBody2"
            android:checked="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetStroke"
            style="@style/LightPanelTextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Reset"
            android:textSize="12sp"
            android:textColor="@color/brand_blue"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- ── Group Kontrol Stroke ── -->
    <LinearLayout
        android:id="@+id/strokeSliderGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="2dp"
        android:visibility="gone">

        <!-- Compose POC host (hidden by default) -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeStrokeControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Warna Outline: preview + hex + tombol '+' -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Color"
                android:textAppearance="?attr/textAppearanceCaption" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chipStrokeColorPreview"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#CCCCCC"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvStrokeColorValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="#FF000000"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="#1A1A2E" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickStrokeColor"
                style="@style/LightPanelOutlinedButton"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_add_24px"
                app:iconSize="18dp" />
        </LinearLayout>

        <!-- Ketebalan & Opasitas sebaris (2 kolom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStrokeWidthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Width: 0 px"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderStrokeWidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="60"
                    android:stepSize="0.5"
                    android:value="0"
                    app:labelBehavior="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStrokeOpacityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Opacity: 100%"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderStrokeOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:stepSize="1"
                    android:value="100"
                    app:labelBehavior="gone" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>