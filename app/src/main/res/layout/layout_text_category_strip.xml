<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/textCategoryStripScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel_bg">

    <!-- Divider atas memisah property panel dari category strip -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/panel_divider" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@color/panel_category_bg"
        android:scrollbars="none"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/textCategoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

</LinearLayout>