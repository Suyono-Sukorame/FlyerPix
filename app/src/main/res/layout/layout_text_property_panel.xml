<?xml version="1.0" encoding="utf-8"?>
<!--
  Text Property Panel (UX ala PixelLab): panel properti kontekstual yang tampil
  di dalam textEditorBar sesuai tool yang dipilih pada strip.

  Memakai komponen reusable DetailPanel (view_detail_panel.xml). Tombol ✓/✕
  pada header disembunyikan karena panel ini hanya menampilkan kontrol (tanpa
  aksi apply/cancel); area konten diisi include panel_font.
  Tinggi area konten dikelola PanelHeightManager agar tidak menutupi canvas.
-->
<com.flyerpix.editor.ui.view.DetailPanel xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/textPropertyPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel_bg"
    android:visibility="gone">

    <!-- Font -->
    <include
        layout="@layout/panel_font"
        android:id="@+id/fontPanel" />

</com.flyerpix.editor.ui.view.DetailPanel>