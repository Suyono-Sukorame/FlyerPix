<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/textPropertyPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:elevation="6dp"
    android:visibility="gone">

    <!-- Header panel: pemindah (handle) kecil + judul tool aktif -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp">

        <View
            android:layout_width="24dp"
            android:layout_height="3dp"
            android:layout_gravity="center_vertical"
            android:background="#DDDDDD" />

        <TextView
            android:id="@+id/textPropertyPanelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Tool"
            android:textColor="#666666"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/textPropertyPanelScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        android:maxHeight="220dp"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Tahap 1: Panel Baru ────────────────────────────────────── -->

            <!-- Color / Padding / Position / Relative / Size / Styles
                 dipindah ke halaman Effect Settings -->

            <!-- Font -->
            <include
                layout="@layout/panel_font"
            android:id="@+id/fontPanel" />

            <!-- ── Efek Kompleks dipindah ke Effect Settings Page ───────── -->
            <!-- (Shadow, Inner, Emboss, Gradient, Texture, 3D Text, 3D Rotate,
                 Perspective, Blend, Neon, Stroke, Spacing, Curve, Style, Mask,
                 Align, Background, Color, Padding, Rotate, Opacity → layout_effect_settings_panel.xml) -->
        </LinearLayout>
    </ScrollView>
</LinearLayout>