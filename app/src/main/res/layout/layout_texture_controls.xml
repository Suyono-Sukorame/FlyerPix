<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel kontrol Texture Masking untuk TextLayer.
  Mengisi teks dengan foto dari galeri HP menggunakan BitmapShader.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/textureControlsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <!-- ── Toggle enable/disable ── -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchTextureEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Texture Masking"
        android:textAppearance="?attr/textAppearanceBody2"
        android:checked="false" />

    <!-- ── Group Kontrol Tekstur ── -->
    <LinearLayout
        android:id="@+id/textureControlsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <!-- Baris Pemilihan Gambar & Preview Thumbnail -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:strokeColor="#CCCCCC"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/imgTextureThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_sharp_photo_24px" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectTexture"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pilih dari Galeri"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteTexture"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Hapus Tekstur"
                    android:textColor="#D32F2F"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Slider Scale Texture (10% - 300%) -->
        <TextView
            android:id="@+id/tvTextureScaleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="4dp"
            android:text="Scale Texture (100%)"
            android:textAppearance="?attr/textAppearanceCaption" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderTextureScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.1"
            android:valueTo="3.0"
            android:stepSize="0.05"
            android:value="1.0"
            app:labelBehavior="gone" />

        <!-- Slider Rotate Texture (0° - 360°) -->
        <TextView
            android:id="@+id/tvTextureRotationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:text="Rotate Texture (0°)"
            android:textAppearance="?attr/textAppearanceCaption" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderTextureRotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="360"
            android:stepSize="1"
            android:value="0"
            app:labelBehavior="gone" />

    </LinearLayout>

</LinearLayout>
