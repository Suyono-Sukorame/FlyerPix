<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/paddingPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Padding Teks"
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:textStyle="bold" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkPaddingLinked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terhubung"
            android:textSize="11sp"
            android:checked="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPaddingTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="4dp"
        android:text="Atas: 0 px"
        android:textAppearance="?attr/textAppearanceCaption" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderPaddingTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="200"
        android:stepSize="1"
        android:value="0"
        app:labelBehavior="gone" />

    <TextView
        android:id="@+id/tvPaddingBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Bawah: 0 px"
        android:textAppearance="?attr/textAppearanceCaption" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderPaddingBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="200"
        android:stepSize="1"
        android:value="0"
        app:labelBehavior="gone" />

    <TextView
        android:id="@+id/tvPaddingLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Kiri: 0 px"
        android:textAppearance="?attr/textAppearanceCaption" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderPaddingLeft"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="200"
        android:stepSize="1"
        android:value="0"
        app:labelBehavior="gone" />

    <TextView
        android:id="@+id/tvPaddingRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Kanan: 0 px"
        android:textAppearance="?attr/textAppearanceCaption" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderPaddingRight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="200"
        android:stepSize="1"
        android:value="0"
        app:labelBehavior="gone" />
</LinearLayout>