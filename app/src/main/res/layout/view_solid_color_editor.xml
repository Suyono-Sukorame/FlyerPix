<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- Preview + hex input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <View
            android:id="@+id/viewColorPreview"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#FFFFFF" />

        <EditText
            android:id="@+id/etHexInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:hint="#FFFFFF"
            android:inputType="textCapCharacters"
            android:maxLength="9"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:paddingHorizontal="12dp"
            android:background="@android:drawable/edit_text" />

    </LinearLayout>

    <!-- Panel SV + strip Hue -->
    <com.flyerpix.editor.ui.dialog.SvHuePanel
        android:id="@+id/svPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp" />

    <!-- Alpha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alpha"
            android:textSize="12sp"
            android:textColor="#666666" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAlpha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:valueFrom="0"
            android:valueTo="255"
            android:stepSize="1"
            android:value="255"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/tvAlphaValue"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="100%"
            android:textSize="12sp"
            android:textColor="#666666" />

    </LinearLayout>

    <!-- Recent colors -->
    <TextView
        android:id="@+id/tvRecentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recent"
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/hsvRecents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/llRecents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- Preset colors -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Presets"
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llPresets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

</LinearLayout>